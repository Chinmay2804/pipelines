pipeline {
    agent any
    tools{
        maven 'mymaven'
        }
    parameters{
        choice(name: 'ENV', choices: ['dev', 'qa', 'prod'], description: 'Select env')
        }
    stages{
        stage('dev'){
            when{
                expression{
                    params.ENV == 'dev'
                    }
                }
            steps{
                git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                sh 'mvn compile'
                }
            post{
                success{
                    echo 'dev success'
                    }
                }
            }
        stage('qa'){
            when{
                expression{
                    params.ENV == 'qa'
                    }
                }
            steps{
                git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                sh 'mvn pmd:pmd'
                sh 'mvn test'
                }
            post{
                success{
                    echo 'qa success'
                    recordIssues sourceCodeRetention: 'LAST_BUILD', tools: [pmdParser(pattern: '**/pmd.xml')]
                    recordIssues sourceCodeRetention: 'LAST_BUILD', tools: [junitParser(pattern: '**/target/surefire-reports/*.xml')]
                    }
                }
            }
        }
    }
